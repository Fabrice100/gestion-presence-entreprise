# ===================================================================
# TEMPLATE PRODUCTION - SYSTÈME DE GESTION DE PRÉSENCE
# ===================================================================
# Instructions :
# 1. Copiez ce fichier vers .env
# 2. Remplissez toutes les valeurs marquées [À_REMPLIR]
# 3. Générez de nouvelles clés sécurisées pour chaque environnement
# 4. Ne JAMAIS committer les fichiers .env

# ===================
# SÉCURITÉ DE BASE
# ===================
# GÉNÉREZ UNE NOUVELLE CLÉ AVEC :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=[À_REMPLIR_CLÉ_SÉCURISÉE_50_CARACTÈRES]
DEBUG=False
ALLOWED_HOSTS=[À_REMPLIR_VOTRE_DOMAINE.COM],www.[À_REMPLIR_VOTRE_DOMAINE.COM]

# ===================
# BASE DE DONNÉES PRODUCTION
# ===================
# PostgreSQL recommandé pour la production
DB_NAME=[À_REMPLIR_NOM_BDD]
DB_USER=[À_REMPLIR_UTILISATEUR_BDD]
DB_PASSWORD=[À_REMPLIR_MOT_DE_PASSE_BDD_SÉCURISÉ]
DB_HOST=localhost
DB_PORT=5432

# ===================
# GÉOLOCALISATION
# ===================
# Coordonnées de votre entreprise
SITE_CENTER_LAT=[À_REMPLIR_LATITUDE]
SITE_CENTER_LNG=[À_REMPLIR_LONGITUDE]
RADIUS_METERS=200
ACCURACY_MAX_METERS=50
GPS_REQUIRED=True

# ===================
# CONFIGURATION EMAIL PRODUCTION
# ===================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=[À_REMPLIR_SMTP_HOST]
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=[À_REMPLIR_EMAIL_UTILISATEUR]
EMAIL_HOST_PASSWORD=[À_REMPLIR_MOT_DE_PASSE_EMAIL]

# ===================
# SÉCURITÉ HTTPS (PRODUCTION)
# ===================
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ===================
# FICHIERS STATIQUES
# ===================
STATIC_ROOT=/path/to/staticfiles/
MEDIA_ROOT=/path/to/media/